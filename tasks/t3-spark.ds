# Task 3 - the same work, kept in memory.
#
# MapReduce writes to disk between every stage. Spark keeps the data and
# remembers how it was produced. Those two facts are the whole
# difference.
#
# The assignments below are the lineage: each step records what it was
# made from. A lost step is not reloaded from disk. It is recomputed from
# its ancestors, which is why the graph is worth keeping.
#
# Try these in order. Each step is marked on the line it belongs to.
#
#   1. run it as it is. e3 is already the slow one. Find it on the
#      picture, and watch the whole stage wait for it
#   2. lose an earlier step instead, and see how much more has to be
#      rebuilt
#   3. bring e3 back up to speed, and watch the straggler go away
#   4. make an executor unreliable and run it many times. It loses
#      whatever it was holding and the lineage rebuilds it. Compare what
#      that costs against MapReduce losing a mapper
#   5. ask yourself which steps could have run at the same time

# --- the machines ----------------------------------------------------

@machine
class Executor:
    pass

e1 = Executor(speed=1.0)
# step 4: add   error_rate=0.3, on_crash="restart", restart_after=0.5
e2 = Executor(speed=1.0)
e3 = Executor(speed=0.4)      # step 3: make it 1.0

# --- the world -------------------------------------------------------

world = World(machines=[e1, e2, e3])

# --- the pipeline ----------------------------------------------------
# Each line says what it came from. That is the lineage.

lines = textFile("chunk001.txt")
words = lines.flatMap(split(value))
pairs = words.mapToPair(value, 1)
counts = pairs.reduceByKey(a + b)

job = Spark(pipeline=counts, lose=counts)   # step 2: lose=pairs

world.run(job)
