# Getting started 1 - a world of machines.
#
# Everything in this course is built out of three things, and this file has
# one of each.
#
#   a class     is a kind of machine, said with a decorator above it
#   an instance is a machine that exists. Nothing runs because a class was
#               declared — `alice = Node()` is what puts a machine on the
#               diagram, under the name `alice`
#   a world     is the machines that exist together, and what a job runs in
#
# Nothing is graded here. The steps are in the panel above.

# --- a kind of machine -----------------------------------------------
# `@machine` says what this class is to the simulator. A method is
# something the machine can be asked to do, and `@duration` is how long
# that takes when the machine is not otherwise held up.

@machine
class Node:
    @duration(0.3)
    def ping(word: string) -> string:
        return word

# --- the machines that exist ------------------------------------------
# Two instances of the same kind. `speed` is a multiplier: 0.5 takes twice
# as long over the same method, which is how you make a slow machine.

alice = Node(speed=1.0)      # step 3: make this 0.25
bob = Node(speed=1.0)
# step 2: add a third machine here, e.g.   carol = Node(speed=1.0)

# --- the world --------------------------------------------------------
# The machines that exist together. A machine you made but did not put in
# the world is not in the picture — try leaving one out and see.

world = World(machines=[alice, bob])   # step 2: add carol to this list too

# --- the work ---------------------------------------------------------
# The work is a function; the job is that function run in the world. Every
# call names the machine it is asking, so both ends are on the page.

def story() -> void:
    alice.ping("hello")
    # step 4: uncomment, and watch a second machine do something
    # bob.ping("and you")

job = Calls(run=story)

world.run(job)
