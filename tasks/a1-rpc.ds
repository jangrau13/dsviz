# Getting started 3 - a client calling two services.
#
# A machine is a decorated class. A call is an ordinary method call on
# another machine, except that this one crosses a network, waits, and can
# fail. Calls are synchronous, so a slow server shows up as the caller
# sitting idle. Statuses follow gRPC: ok, unavailable, unimplemented,
# deadline_exceeded.
#
# Every line you need is written below and commented out, marked with the
# step it belongs to. The steps are listed in the panel above.

@machine
class Ledger:
    @duration(0.4)
    def balance(account: string) -> int:
        return 120

@machine
class Rates:
    @duration(0.9)
    def to_euros(amount: int) -> int:
        return amount * 2

# step 5: make error_rate 0.5
# step 6: then add   on_crash="restart", restart_after=0.5
bank = Ledger(speed=1.0, error_rate=0.0)
fx = Rates(speed=1.0)

# --- the world -------------------------------------------------------

world = World(machines=[bank, fx])

# --- the job ---------------------------------------------------------
# The work is a function. The job is that function run in the world.

def story() -> void:
    # The second call needs the answer to the first, so the caller sits
    # and waits in between. That waiting is what the network costs you,
    # and the timeline shows it.

    # step 3: uncomment the next line, so the bank is already down
    # before anyone asks it anything
    # bank.crash()

    chf: int = bank.balance("savings")    # step 3: add  , retries=2
    eur: int = fx.to_euros(chf)           # step 2: add  , deadline=0.2

    # step 4: uncomment both. You bring it back, here, and it answers
    # bank.restart()
    # again: int = bank.balance("savings")

# `times` is how many rounds of the job to run.
client = Calls(run=story, times=1)         # step 5: make it 4

world.run(client)
