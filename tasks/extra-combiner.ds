# Extra - the answer must not change, only the traffic.
#
# Bring your mapper and reducer across from the word count and add a
# combiner. It runs on the mapper, before anything crosses the network,
# and may run zero times, once, or many times over the same data — so it
# has to be safe however often it runs.
#
# Watch NETWORK_MSGS before and after.

@mapper
class Worker:
    pass

@reducer
class Collector:
    pass

m1 = Worker(speed=1.0)
m2 = Worker(speed=1.0)
m3 = Worker(speed=1.0)
r1 = Collector(speed=1.0)
r2 = Collector(speed=1.0)

world = World(machines=[m1, m2, m3, r1, r2])

