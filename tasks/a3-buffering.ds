# Task 2.2 - showing a message only when it makes sense.
#
# A vector clock is enough to say what is ordered. It is not enough on its
# own: knowing that B depends on A does not stop B being displayed first
# if B gets there first.
#
# This is a chat, so every line goes to everyone — that is `broadcast`,
# and the rule below is only defined for messages that go to everyone.
# `late=p3` says one copy takes the slow route.
#
# A message that fails the rule is held, not dropped, and offered again
# every time something is delivered.

@process
class Node:
    pass

p1 = Node(speed=1.0)      # step 3: make it 0.3
p2 = Node(speed=1.0)
p3 = Node(speed=1.0)

# --- the world -------------------------------------------------------

world = World(machines=[p1, p2, p3])

# --- the conversation ------------------------------------------------

def story() -> void:
    # p1 says something, and p3's copy is slow to arrive
    p1.broadcast("A", late=p3)
    # p2 has seen A, and answers it. Everyone gets this one straight away,
    # p3 included — so p3 has the answer before the question
    p2.broadcast("B")
    # step 4: add a third line here, and pick who is late

# step 2: add   , delivery="causal"
job = Calls(run=story)

world.run(job)
