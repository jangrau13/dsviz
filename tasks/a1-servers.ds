# Task 5 - the same word count, split across servers.
#
# In Task 1 the map and the reduce were two functions in one program.
# Nothing was distributed: a function call is a function call. Here they
# are two machines, and the client has to ask each of them over a network.
#
# The code looks almost the same. What changed is that every arrow between
# two boxes can now be slow, arrive late, or not arrive at all — and the
# client has to say what it wants done about that.

@machine
class MapServer:
    @duration(0.6)
    def mapChunk(chunk: string) -> string:
        return chunk

@machine
class ReduceServer:
    @duration(0.4)
    def reduceChunk(pairs: string) -> string:
        return pairs

# step 5: make error_rate 0.5
# step 6: then add   on_crash="restart", restart_after=0.5
mapping = MapServer(speed=1.0, error_rate=0.0)
reducing = ReduceServer(speed=1.0)

# --- the world -------------------------------------------------------

world = World(machines=[mapping, reducing])

# --- the client ------------------------------------------------------
# The client is not a machine you declared. It is the job: the sequence of
# calls that makes the work happen.

def story() -> void:
    # step 3: uncomment, so the map server is already down before the
    # client asks it for anything
    # mapping.crash()

    first: string = mapping.mapChunk("chunk001.txt")   # step 3: add  , retries=2
    second: string = mapping.mapChunk("chunk002.txt")  # step 2: add  , deadline=0.3

    # step 4: uncomment both. You bring it back, here, and it answers
    # mapping.restart()
    # again: string = mapping.mapChunk("chunk002.txt")

    # The reduce cannot start until both maps have come back. That wait is
    # the barrier, and on the timeline it is the gap before this line.
    counts: string = reducing.reduceChunk(first)

# `times` is how many rounds of the job to run.
client = Calls(run=story, times=1)                     # step 5: make it 4

world.run(client)
